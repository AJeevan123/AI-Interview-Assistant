# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=ai_interview_coach

# JWT Security
SECRET_KEY=ai-interview-coach-super-secret-jwt-key-production-grade-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API Configuration
# Provide your Gemini API key here (https://aistudio.google.com/app/apikey)
# If left empty or on API failure, the intelligent heuristic fallback engine runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# File Uploads Directory
UPLOAD_DIR=uploads
